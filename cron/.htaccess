# AVIVA Match sheet import is command-line only (cPanel cron). Block web access.
<FilesMatch "^aviva-match-(sheet-sync|admin)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
