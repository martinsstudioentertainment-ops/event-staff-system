# Local secrets — never commit
/config.php
/deploy.local.ps1
/storage/google/service-account.json
/storage/google/*.json
apply/admin/config/database.php
apply/admin/config/eventstaff-database.php
apply/admin/config/sso.local.php
apply/admin/config/google-service-account.json

# Runtime data
/storage/logs/*
!/storage/logs/.gitkeep
/storage/backups/*
!/storage/backups/.gitkeep
!/storage/backups/database/.gitkeep
!/storage/backups/weekly/.gitkeep

# IDE / OS
/.vscode/
/.idea/
.DS_Store
Thumbs.db
*.log

# Env / local overrides
.env
.env.*

# Local dumps / archives — never commit
apply/admin.zip
apply/*.sql
*.sql.gz

# Cursor (optional)
/.cursor/
storage/staff-template-ods/
storage/tmp-staff-template-content.xml

# Forensic / recovery / audit temp (not production source)
/_recovery-staging/
/_tmp-restore/
/_phase3_recovery_contents/
/_phase3_recovery_summary.json
/.audit-admin.json
/_audit_verify.json
/_extract_transcripts*
/_fix_*_report.js
/_reconstruct*
/_reconstructed_*
/_transcript_extraction_report.json
/_tmp_prod_signout.php
*.php.prod

# Android build output (not web production source)
/android/**/build/
/android/**/.gradle/
/handover-package/local-secrets/

# Large binaries (APK/AAB — distribute separately)
*.apk
*.aab
/play-store-assets/build-aab/